   "source": [
    "# Optimización de Hiperparámetros con Validación Cruzada (K-Fold) y RandomizedSearchCV\n",
    "\n",
    "# 1. Definir la estrategia de Validación Cruzada (K-Fold)\n",
    "# cv=5 significa que dividimos los datos en 5 partes (folds)\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "# 2. Definir el modelo y el \"espacio de búsqueda\"\n",
    "rf = RandomForestRegressor(random_state=42)\n",
    "\n",
    "param_dist = {\n",
    "    'n_estimators': [100, 200, 300],        # Número de árboles\n",
    "    'max_depth': [10, 20, 30, None],        # Profundidad máxima\n",
    "    'min_samples_split': [2, 5, 10],        # Mínimo de datos para dividir un nodo\n",
    "    'max_features': ['sqrt', 'log2']        # Cuántas características mirar\n",
    "}\n",
    "\n",
    "# 3. Configurar la Optimización (RandomSearch) con Validación Cruzada\n",
    "# Esto probará 20 combinaciones aleatorias, evaluando cada una 5 veces (K-Fold)\n",
    "random_search = RandomizedSearchCV(\n",
    "    estimator=rf,\n",
    "    param_distributions=param_dist,\n",
    "    n_iter=20,              # Probar 20 combinaciones (RandomSearch)\n",
    "    cv=kf,                  # Aquí aplicamos K-Fold Cross Validation\n",
    "    scoring='neg_mean_squared_error', # Métrica a optimizar\n",
    "    n_jobs=-1,              # Usar todos los procesadores\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# 4. Entrenar\n",
    "print(\"Iniciando búsqueda de hiperparámetros con validación cruzada...\")\n",
    "random_search.fit(X_train, y_train)\n",
    "\n",
    "print(f\"Mejores hiperparámetros: {random_search.best_params_}\")\n",
    "best_model = random_search.best_estimator_"
   ]

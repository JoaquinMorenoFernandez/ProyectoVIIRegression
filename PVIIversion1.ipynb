    "    'Precio Predicho': y_pred_best,\n",
    "    'Error ($)': y_test.values - y_pred_best,\n",
    "    'Error (%)': ((y_test.values - y_pred_best) / y_test.values * 100)\n",
    "})\n",
    "\n",
    "# Agregar columna de evaluación\n",
    "predictions_df['Evaluación'] = predictions_df['Error ($)'].abs().apply(\n",
    "    lambda x: 'Excelente' if x < 5000 else ('Buena' if x < 15000 else ('Regular' if x < 30000 else 'Pobre'))\n",
    ")\n",
    "\n",
    "# Ordenar por error absoluto\n",
    "predictions_df['Error Abs ($)'] = abs(predictions_df['Error ($)'])\n",
    "predictions_sorted = predictions_df.sort_values('Error Abs ($)')\n",
    "\n",
    "# Mostrar resumen de precisión\n",
    "print(f\"\\n📊 MÉTRICAS DE DESEMPEÑO:\")\n",
    "print(f\"   • Error Medio Absoluto (MAE): ${predictions_df['Error ($)'].abs().mean():,.2f}\")\n",
    "print(f\"   • Error Porcentual Medio: {predictions_df['Error (%)'].abs().mean():.2f}%\")\n",
    "print(f\"   • Error Máximo: ${predictions_df['Error ($)'].abs().max():,.2f}\")\n",
    "print(f\"   • Error Mínimo: ${predictions_df['Error ($)'].abs().min():,.2f}\")\n",
    "\n",
    "# Contar evaluaciones\n",
    "eval_counts = predictions_df['Evaluación'].value_counts()\n",
    "print(f\"\\n✓ DISTRIBUCIÓN DE PRECISIÓN:\")\n",
    "for eval_type, count in eval_counts.items():\n",
    "    percentage = (count / len(predictions_df)) * 100\n",
    "    print(f\"   • {eval_type}: {count} predicciones ({percentage:.1f}%)\")\n",
